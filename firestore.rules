rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function profilePath(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me()         { return get(profilePath()).data; }
    function isActive()   { return hasProfile() && me().active == true; }
    function isAdmin()    { return isActive() && me().role == 'admin'; }
    function setupOpen()  { return !exists(/databases/$(database)/documents/meta/setup); }
    // وضع الصيانة: لما يتفعّل المستخدم العادي مبيقدرش يقرا الأدوات خالص
    function maintenanceOn() {
      return exists(/databases/$(database)/documents/meta/site)
          && get(/databases/$(database)/documents/meta/site).data.get('maintenance', false) == true;
    }

    // خريطة الرقم الوظيفي -> الإيميل الداخلي (لازم تتقري قبل تسجيل الدخول)
    // get مسموح، list ممنوع عشان محدش يسحب قايمة الموظفين.
    match /loginMap/{empId} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if isAdmin() || (signedIn() && setupOpen());
      allow update: if isAdmin() || (signedIn() && setupOpen())
                    // الموظف في أول دخول بيمسح المفتاح المؤقت بس
                    || (signedIn() && resource.data.uid == request.auth.uid
                        && resource.data.needsPassword == true
                        && request.resource.data.needsPassword == false
                        && !('initKey' in request.resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsPassword', 'initKey']));
    }

    // إعدادات الموقع (وضع الصيانة + رسالتها + نسخة الملفات): الكل يقرا، الأدمن بس يكتب
    match /meta/site {
      allow get: if true;
      allow write: if isAdmin();
    }

    // حالة الإعداد الأول: بيتقفل بعد أول أدمن
    match /meta/setup {
      allow get: if true;
      allow create: if signedIn() && setupOpen();
      allow update, delete: if false;
    }

    // ملفات المستخدمين
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && setupOpen()
                        && request.resource.data.role == 'admin');
      allow update: if isAdmin()
                    // الموظف يقدر يغيّر علامة pending بتاعته بس (بعد ما يختار كلمة المرور)
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending']));
      allow delete: if isAdmin();
    }

    // قفل الجلسة على جهاز واحد: مستند لكل مستخدم فيه sid عشوائي بيتجدد بنبضة كل 30 ثانية.
    // جهاز تاني ميقدرش ياخد الجلسة طول ما النبضة أحدث من دقيقتين (120 ثانية) إلا لو الجلسة اتقفلت (تسجيل خروج).
    function validSess() {
      let d = request.resource.data;
      return d.keys().hasOnly(['sid', 'device', 'startedAt', 'lastSeen', 'closed'])
          && d.sid is string && d.sid.size() >= 20 && d.sid.size() <= 64
          && d.device is string && d.device.size() <= 60
          && d.lastSeen == request.time
          && d.closed is bool;
    }
    // الربط الدايم بجهاز: أول جهاز يدخل بيتسجّل هنا، وبعدها أي جهاز تاني ميقدرش ياخد جلسة لحد ما الأدمن يمسح المستند ده.
    // (بيتطبق على المستخدم اللي deviceLock عنده مش false)
    function devPath()  { return /databases/$(database)/documents/devices/$(request.auth.uid); }
    function lockOn()   { return me().get('deviceLock', true) == true; }
    function deviceOk() { return !lockOn() || (existsAfter(devPath()) && getAfter(devPath()).data.sid == request.resource.data.sid); }
    match /devices/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['sid', 'device', 'boundAt'])
                    && request.resource.data.sid is string && request.resource.data.sid.size() >= 20 && request.resource.data.sid.size() <= 64
                    && request.resource.data.device is string && request.resource.data.device.size() <= 60
                    && request.resource.data.boundAt == request.time;
      allow update, delete: if isAdmin();
    }
    match /sessions/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && validSess() && deviceOk();
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid && validSess() && deviceOk()
                        && (resource.data.sid == request.resource.data.sid
                            || resource.data.closed == true
                            || resource.data.lastSeen < request.time - duration.value(120, 's')));
      allow delete: if isAdmin();
    }

    // بيانات الأدوات (الاسم/الوصف/الأيقونة) - يشوفها أي مستخدم مفعّل
    // ======================= نظام مواعيد الفروع =======================
    // الأدوار (users.sched): leader = ليدر ثابت على عربيات (trucks.leaders) | rep = مندوب بيتعيّن على عربية ليوم معيّن (assign) | dock = مندوب مخزن
    function sched()   { return me().get('sched', ''); }
    function okUser()  { return isActive() && !maintenanceOn(); }
    function isLeader(){ return okUser() && sched() == 'leader'; }
    function isRep()   { return okUser() && sched() == 'rep'; }
    function isDock()  { return okUser() && sched() == 'dock'; }
    function sessPath(){ return /databases/$(database)/documents/sessions/$(request.auth.uid); }
    function sidMatches(s) { return get(sessPath()).data.sid == s && get(sessPath()).data.closed == false; }
    function isTime(t) { return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    function isDay(t)  { return t is string && t.matches('^20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function mins(t)   { return int(t.split(':')[0]) * 60 + int(t.split(':')[1]); }
    function branchOf(id) { return get(/databases/$(database)/documents/branches/$(id)).data; }
    function truckOf(id)  { return get(/databases/$(database)/documents/trucks/$(id)).data; }
    function assignPath(date, truckId) { return /databases/$(database)/documents/assign/$(date + '_' + truckId); }
    function leaderOf(t) { return isLeader() && request.auth.uid in t.leaders; }
    function repOf(date, truckId) {
      return isRep() && exists(assignPath(date, truckId)) && get(assignPath(date, truckId)).data.rep == request.auth.uid;
    }

    match /trucks/{id} {
      allow read: if isAdmin() || (okUser() && sched() in ['leader', 'rep', 'dock']);
      allow write: if isAdmin();
    }
    match /branches/{id} {
      allow read: if isAdmin() || (okUser() && sched() in ['leader', 'rep', 'dock']);
      allow write: if isAdmin();
    }
    // تعيين مندوب على عربية في يوم (assign/{date}_{truckId}): الأدمن بس يكتب
    match /assign/{aid} {
      allow get: if isAdmin() || (okUser() && (resource == null || resource.data.rep == request.auth.uid || leaderOf(truckOf(resource.data.truckId))));
      allow list: if isAdmin() || (okUser() && resource.data.rep == request.auth.uid);
      allow write: if isAdmin();
    }

    // كل فرع في اليوم له مستند واحد (entries/{date}_{branchId}): أول واحد يبعته (الليدر أو المندوب المعيّن) هو اللي بيتسجّل.
    // مفيش تعديل ولا مسح غير للأدمن. القواعد بتتأكد من: الصلاحية على العربية، الجلسة، صيغة الوقت، ميعاد الفرع الحقيقي،
    // وإن التأخير (أكتر من 30 دقيقة) أو النقص ليه سبب مكتوب.
    function entryOk(eid) {
      let d = request.resource.data;
      let b = branchOf(d.branchId);
      let t = truckOf(b.truckId);
      let late = d.arrival != null && mins(d.arrival) > mins(b.time) + 30;
      let incomplete = d.holiday == false && (d.arrival == null || d.end == null);
      return okUser()
        && ((d.role == 'leader' && leaderOf(t)) || (d.role == 'rep' && repOf(d.date, b.truckId)))
        && d.keys().hasOnly(['date', 'branchId', 'uid', 'by', 'role', 'arrival', 'end', 'holiday', 'note', 'late', 'schedTime', 'sentAt', 'sid', 'status'])
        && d.keys().hasAll(['date', 'branchId', 'uid', 'by', 'role', 'arrival', 'end', 'holiday', 'note', 'late', 'schedTime', 'sentAt', 'sid', 'status'])
        && d.uid == request.auth.uid && d.by == me().name
        && isDay(d.date)
        && eid == d.date + '_' + d.branchId
        && d.status == 'sent' && d.sentAt == request.time
        && sidMatches(d.sid)
        && d.holiday is bool
        && (d.holiday == true
            ? (d.arrival == null && d.end == null)
            : ((d.arrival == null || isTime(d.arrival)) && (d.end == null || isTime(d.end))))
        && d.schedTime == b.time && d.late == late
        && d.note is string && d.note.size() <= 300
        && (!(late || incomplete) || d.note.size() >= 3);
    }
    match /entries/{eid} {
      allow get: if isAdmin() || (okUser() && (resource == null
          || resource.data.uid == request.auth.uid
          || leaderOf(truckOf(branchOf(resource.data.branchId).truckId))
          || repOf(resource.data.date, branchOf(resource.data.branchId).truckId)));
      allow list: if isAdmin() || (okUser() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || entryOk(eid);
      allow update, delete: if isAdmin();
    }

    function dockCreateOk(did) {
      let d = request.resource.data;
      return isDock()
        && d.keys().hasOnly(['date', 'truckId', 'uid', 'inTime', 'outTime', 'sentAt', 'sid', 'status'])
        && d.keys().hasAll(['date', 'truckId', 'uid', 'inTime', 'outTime', 'sentAt', 'sid', 'status'])
        && d.uid == request.auth.uid && isDay(d.date) && did == d.date + '_' + d.truckId
        && exists(/databases/$(database)/documents/trucks/$(d.truckId))
        && isTime(d.inTime) && d.outTime == null
        && d.status == 'sent' && d.sentAt == request.time && sidMatches(d.sid);
    }
    function dockUpdateOk() {
      let d = request.resource.data;
      return isDock() && resource.data.outTime == null && resource.data.status == 'sent'
        && d.diff(resource.data).affectedKeys().hasOnly(['outTime', 'outAt', 'outSid'])
        && isTime(d.outTime) && d.outAt == request.time && sidMatches(d.outSid);
    }
    match /docks/{did} {
      allow read: if isAdmin() || isDock();
      allow create: if isAdmin() || dockCreateOk(did);
      allow update: if isAdmin() || dockUpdateOk();
      allow delete: if isAdmin();
    }

    // سجل النشاط: أي مستخدم مفعّل يسجّل نشاطه هو بس، والأدمن بس اللي يقرا. مفيش تعديل ولا مسح.
    match /activity/{aid} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'detail', 'page', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() <= 30
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300
        && request.resource.data.page is string && request.resource.data.page.size() <= 40;
      allow update, delete: if false;
    }

    // رابط Apps Script والمفتاح السري: للأدمن بس
    match /meta/sheetBridge {
      allow read, write: if isAdmin();
    }

    match /tools/{toolId} {
      allow read: if isAdmin() || (isActive() && !maintenanceOn());
      allow write: if isAdmin();
    }

    // كود الأدوات المخزّن في قاعدة البيانات - بس للأدمن أو اللي معاه صلاحية الأداة
    match /toolCode/{toolId} {
      allow get: if isAdmin()
                 || (isActive() && !maintenanceOn() && (me().allTools == true || toolId in me().toolIds));
      allow list: if false;
      allow write: if isAdmin();
    }

    // قائمة أسعار المنتجات (أدوات حساب الأسعار): الكل يقرا (لو مفيش صيانة)، الأدمن بس يكتب
    match /prices/{docId} {
      allow read: if isAdmin() || (isActive() && !maintenanceOn());
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
